<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFGUITool.ViewModels"
        x:Class="FFGUITool.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="960" Height="800"
        MinWidth="800" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}"
        Icon="/Resources/icon.ico">

    <!-- <Window.Resources> -->
    <!--     <ResourceDictionary> -->
    <!--         <ResourceDictionary.ThemeDictionaries> -->
    <!--             <ResourceDictionary x:Key="Light"> -->
    <!--                 <Color x:Key="PageBackgroundColor">#F3F4F6</Color> -->
    <!--                 <Color x:Key="CardBackgroundColor">#FFFFFF</Color> -->
    <!--                 <Color x:Key="PrimaryTextColor">#1F2937</Color> -->
    <!--                 <Color x:Key="SecondaryTextColor">#6B7280</Color> -->
    <!--                 <Color x:Key="AccentColor">#3B82F6</Color> -->
    <!--                 <Color x:Key="AccentHoverColor">#2563EB</Color> -->
    <!--                 <Color x:Key="BorderColor">#E5E7EB</Color> -->
    <!--                 <Color x:Key="ConsoleBgColor">#111827</Color> -->
    <!-- -->
    <!--                 <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" /> -->
    <!--                 <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" /> -->
    <!--                 <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" /> -->
    <!--                 <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" /> -->
    <!--                 <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" /> -->
    <!--                 <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" /> -->
    <!-- -->
    <!--                 <BoxShadows x:Key="CardShadow">0 4 6 -1 #1A000000, 0 2 4 -1 #0D000000, 0 2 10 0 #15000000, 0 4 12 0 #40000000</BoxShadows> -->
    <!--             </ResourceDictionary> -->
    <!-- -->
    <!--             <ResourceDictionary x:Key="Dark"> -->
    <!--                 <Color x:Key="PageBackgroundColor">#121212</Color> -->
    <!--                 <Color x:Key="CardBackgroundColor">#1E1E1E</Color> -->
    <!--                 <Color x:Key="PrimaryTextColor">#E5E7EB</Color> -->
    <!--                 <Color x:Key="SecondaryTextColor">#9CA3AF</Color> -->
    <!--                 <Color x:Key="AccentColor">#60A5FA</Color> -->
    <!--                 <Color x:Key="AccentHoverColor">#3B82F6</Color> -->
    <!--                 <Color x:Key="BorderColor">#374151</Color> -->
    <!--                 <Color x:Key="ConsoleBgColor">#000000</Color> -->
    <!-- -->
    <!--                 <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" /> -->
    <!--                 <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" /> -->
    <!--                 <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" /> -->
    <!--                 <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" /> -->
    <!--                 <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" /> -->
    <!--                 <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" /> -->
    <!-- -->
    <!--                 <BoxShadows x:Key="CardShadow">0 4 6 -1 #66000000</BoxShadows> -->
    <!--             </ResourceDictionary> -->
    <!--         </ResourceDictionary.ThemeDictionaries> -->
    <!--     </ResourceDictionary> -->
    <!-- </Window.Resources> -->

    <Window.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.H1">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RecognizesAccessKey" Value="False" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="Button.Accent:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style Selector="CheckBox.VideoTool">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style Selector="CheckBox.VideoTool:disabled">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="Auto, *">
        <Menu Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}">
            <MenuItem Header="{DynamicResource Menu.Tools}" Foreground="{DynamicResource PrimaryTextBrush}">
                <MenuItem Header="{DynamicResource Menu.FFmpegSettings}" Command="{Binding ShowFFmpegSettingsCommand}" />
                <MenuItem Header="{DynamicResource Menu.ExifToolSettings}" Command="{Binding ConfigureExifToolCommand}" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.RedetectFFmpeg}" Command="{Binding RedetectFFmpegCommand}" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Language}">
                    <MenuItem Header="{DynamicResource Menu.Language.Chinese}" Command="{Binding SetLanguageCommand}" CommandParameter="zh-CN" />
                    <MenuItem Header="{DynamicResource Menu.Language.English}" Command="{Binding SetLanguageCommand}" CommandParameter="en-US" />
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu.Theme}">
                    <MenuItem Header="{Binding ThemeSystemMenuText}" Command="{Binding SetThemeCommand}" CommandParameter="Default" />
                    <MenuItem Header="{Binding ThemeLightMenuText}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    <MenuItem Header="{Binding ThemeDarkMenuText}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Menu.OpenConfigFolder}" Command="{Binding OpenConfigFolderCommand}" />
                <MenuItem Header="{DynamicResource Menu.CleanupLocalData}" Command="{Binding CleanupLocalDataCommand}" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Help}" Foreground="{DynamicResource PrimaryTextBrush}">
                <MenuItem Header="{DynamicResource Menu.About}" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Border x:Name="ModeSelectionRoot"
                Grid.Row="1"
                IsVisible="{Binding IsModeSelectionVisible}"
                Margin="24"
                Classes="Card"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="720">
            <StackPanel Spacing="24">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="FFGUITool" FontSize="34" FontWeight="ExtraBold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Mode.Choose}" FontSize="16"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Grid ColumnDefinitions="300,40,300" HorizontalAlignment="Center">
                    <Button Command="{Binding SelectVideoModeCommand}"
                            Height="170"
                            Width="300"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <StackPanel Spacing="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="250">
                            <TextBlock Text="▶" FontSize="42" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Mode.Video}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Mode.VideoDesc}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding SelectImageModeCommand}"
                            Height="170"
                            Width="300"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <StackPanel Spacing="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="250">
                            <TextBlock Text="▧" FontSize="42" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Mode.Image}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Mode.ImageDesc}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Grid x:Name="WorkspaceRoot"
              Grid.Row="1"
              Margin="24"
              RowDefinitions="Auto, *, Auto"
              IsVisible="{Binding IsWorkspaceVisible}">

            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FFGUITool" FontSize="28" FontWeight="ExtraBold"
                               Foreground="{DynamicResource AccentBrush}" LetterSpacing="1" />
                    <TextBlock Text="{Binding CurrentModeTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="14,0,0,0"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BorderBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding FfmpegStatusText}" FontSize="12"
                                   Foreground="{Binding FfmpegStatusColor}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding BackToModeSelectionCommand}"
                        Content="{DynamicResource Mode.Switch}"
                        Height="32"
                        Margin="0,0,10,0" />

                <Button Grid.Column="2" Command="{Binding ToggleThemeCommand}"
                        Classes="Icon" BorderThickness="0" Background="Transparent"
                        ToolTip.Tip="{DynamicResource Theme.Toggle}">
                    <Panel Width="24" Height="24">
                        <TextBlock Text="◐" FontSize="20" IsVisible="{Binding IsThemeSystem}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="☀" FontSize="18" IsVisible="{Binding IsThemeLight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="☾" FontSize="18" IsVisible="{Binding IsThemeDarkManual}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="0,0,16,0">
                <StackPanel>

                    <Border Classes="Card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="H1" Text="{Binding InputSourceTitle}" />
                            <Grid ColumnDefinitions="*, 10, Auto, 10, Auto">
                                <TextBox Grid.Column="0" Text="{Binding InputPathText}"
                                         Watermark="{DynamicResource Main.InputWatermark}" IsReadOnly="True" Height="38"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Content="{DynamicResource Main.SelectFile}" Command="{Binding SelectFileCommand}"
                                        Height="38" />
                                <Button Grid.Column="4" Content="{DynamicResource Main.SelectFolder}" Command="{Binding SelectFolderCommand}"
                                        Height="38" />
                            </Grid>
                            <TextBlock Text="{Binding BatchModeText}"
                                       IsVisible="{Binding IsBatchMode}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="Card" IsVisible="{Binding IsVideoInfoVisible}">
                        <StackPanel Spacing="10">
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Classes="H1" Text="{Binding SourceInfoTitle}" DockPanel.Dock="Left" Margin="0"
                                           VerticalAlignment="Center" />

                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="8,4"
                                        DockPanel.Dock="Right" VerticalAlignment="Center"
                                        IsVisible="{Binding IsSourceBadgeVisible}">
                                    <TextBlock Text="{Binding SourceBadgeText}"
                                               Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </DockPanel>

                            <UniformGrid Columns="3" Rows="1" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="{Binding SourceSizeLabel}" Classes="Label" FontSize="12" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CurrentVideoInfo.FormattedFileSize}" FontSize="16"
                                               FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding SourceSecondMetricLabel}" Classes="Label" FontSize="12" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SourceSecondMetricValue}" FontSize="16"
                                               FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding SourceThirdMetricLabel}" Classes="Label" FontSize="12" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SourceThirdMetricValue}"
                                               FontSize="16" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                            </UniformGrid>

                        </StackPanel>
                    </Border>

                    <Border Classes="Card">
                        <StackPanel Spacing="20">
                            <TextBlock Classes="H1" Text="{Binding CompressionParamsTitle}" />

                            <Grid ColumnDefinitions="100, *" Margin="0,0,0,16">
                                <TextBlock Grid.Column="0" Text="{Binding TargetSizeLabel}" Classes="Label" VerticalAlignment="Center"/>
    
                                <StackPanel Grid.Column="1">
                                    <Grid ColumnDefinitions="*, 12, 88, 6, 78" MinHeight="34">
                                        <Slider Grid.Column="0" 
                                                Value="{Binding TargetSizeSliderValue}" 
                                                Minimum="{Binding TargetSizeSliderMinimum}" 
                                                Maximum="{Binding TargetSizeSliderMaximum}" 
                                                IsEnabled="{Binding CanEditTargetSize}"
                                                VerticalAlignment="Center" 
                                                Height="34"/>
            
                                        <TextBox Text="{Binding TargetSizeMB, Mode=TwoWay}" 
                                                 Grid.Column="2"
                                                 Width="88"
                                                 Height="34"
                                                 IsEnabled="{Binding CanEditTargetSize}"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center" 
                                                 HorizontalContentAlignment="Center"/>
                                        <TextBlock Text="{Binding TargetSizeUnitText}"
                                                   Grid.Column="4"
                                                   IsVisible="{Binding !IsImageTargetUnitSelectorVisible}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <ComboBox ItemsSource="{Binding ImageTargetSizeUnitOptions}"
                                                  Grid.Column="4"
                                                  SelectedItem="{Binding SelectedImageTargetSizeUnit}"
                                                  IsVisible="{Binding IsImageTargetUnitSelectorVisible}"
                                                  IsEnabled="{Binding CanEditTargetSize}"
                                                  Width="78"
                                                  Height="34"
                                                  VerticalAlignment="Center"
                                                  HorizontalContentAlignment="Center" />
                                    </Grid>
        
                                    <TextBlock Text="{Binding TargetSizeSelectionText}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource SecondaryTextBrush}" 
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="100, *" IsVisible="{Binding !IsImageMode}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Main.CompressionPreset}" Classes="Label" VerticalAlignment="Center"/>
                                    <Button Content="?"
                                            Command="{Binding ShowCompressionPresetHelpCommand}"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="{DynamicResource Preset.HelpTitle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CompressionPresetOptions}" SelectedItem="{Binding SelectedCompressionPresetOption}" 
                                          HorizontalAlignment="Left" Width="360">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="16"
                                    Padding="12,8" HorizontalAlignment="Left">
                                <CheckBox Content="{DynamicResource Main.AdvancedMode}"
                                          IsChecked="{Binding IsAdvancedMode}"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Border>

                            <StackPanel Spacing="12" IsVisible="{Binding IsAdvancedMode}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Main.ConversionTools}" Classes="Label" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Content="?"
                                                Command="{Binding ShowConversionHelpCommand}"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ToolTip.Tip="{DynamicResource Conversion.HelpTitle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ConversionModeHint}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>

                                <UniformGrid Columns="3" Rows="1">
                                    <CheckBox Content="{DynamicResource Main.FormatConversion}"
                                              Classes="VideoTool"
                                              IsChecked="{Binding EnableFormatConversion}"
                                              IsEnabled="{Binding CanEditVideoConversionTools}" />
                                    <CheckBox Content="{DynamicResource Main.AudioConversion}"
                                              IsVisible="{Binding !IsImageMode}"
                                              IsChecked="{Binding EnableAudioConversion}"
                                              Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <CheckBox Content="{DynamicResource Main.ResolutionConversion}"
                                              Classes="VideoTool"
                                              IsChecked="{Binding EnableResolutionConversion}"
                                              IsEnabled="{Binding CanEditVideoConversionTools}" />
                                </UniformGrid>

                                <Grid ColumnDefinitions="100, *" IsVisible="{Binding IsFormatConversionOptionsVisible}">
                                    <TextBlock Text="{Binding FormatOptionLabel}" Classes="Label" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding VideoFormatOptions}" SelectedItem="{Binding SelectedVideoFormatOption}"
                                              IsVisible="{Binding !IsImageMode}"
                                              HorizontalAlignment="Left" Width="300">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ImageFormatOptions}" SelectedItem="{Binding SelectedImageFormatOption}"
                                              IsVisible="{Binding IsImageMode}"
                                              HorizontalAlignment="Left" Width="300">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="100, *" IsVisible="{Binding IsAudioConversionOptionsVisible}">
                                    <TextBlock Text="{DynamicResource Main.AudioFormat}" Classes="Label" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AudioFormatOptions}" SelectedItem="{Binding SelectedAudioFormatOption}"
                                              HorizontalAlignment="Left" Width="300">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="100, *" IsVisible="{Binding IsAudioConversionOptionsVisible}">
                                    <TextBlock Text="{DynamicResource Main.AudioBitrate}" Classes="Label" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AudioBitrateOptions}" SelectedItem="{Binding SelectedAudioBitrateOption}"
                                              HorizontalAlignment="Left" Width="300">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="100, *" IsVisible="{Binding IsResolutionConversionOptionsVisible}">
                                    <TextBlock Text="{DynamicResource Main.TargetResolution}" Classes="Label" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolutionOption}"
                                              HorizontalAlignment="Left" Width="300">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <TextBlock Text="{DynamicResource Main.Privacy}"
                                           Classes="Label"
                                           FontWeight="Bold"
                                           IsVisible="{Binding IsMetadataClearOptionVisible}" />
                                <CheckBox Content="{DynamicResource Metadata.Clear}"
                                          IsChecked="{Binding ClearMetadata}"
                                          IsVisible="{Binding IsMetadataClearOptionVisible}"
                                          IsEnabled="{Binding CanClearMetadata}"
                                          Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{Binding MetadataClearHint}"
                                           IsVisible="{Binding IsMetadataClearOptionVisible}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                        Padding="10" IsVisible="{Binding IsMetadataPreviewVisible}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{DynamicResource Metadata.ClearPreview}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding SourceMetadataText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <Separator Background="{DynamicResource BorderBrush}" Height="1" Opacity="0.5"
                                       Margin="0,0,0,16"
                                       IsVisible="{Binding IsAdvancedMode}" />

                            <Grid ColumnDefinitions="100, *, Auto" Margin="0,0,0,16" IsVisible="{Binding IsAdvancedQualityControlsVisible}">
                                <TextBlock Grid.Column="0" Text="{Binding AdvancedBitrateLabel}" Classes="Label" VerticalAlignment="Top"
                                           Margin="0,6,0,0" />

                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Slider Grid.Column="0" Value="{Binding BitrateSliderValue}"
                                                Minimum="{Binding BitrateSliderMinimum}"
                                                Maximum="{Binding BitrateSliderMaximum}"
                                                IsEnabled="{Binding CanEditBitrate}"
                                                VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <TextBox Grid.Column="1" Text="{Binding Bitrate}" Width="80"
                                                 IsEnabled="{Binding CanEditBitrate}"
                                                 VerticalContentAlignment="Center" 
                                                 HorizontalContentAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{Binding BitrateSelectionText}"
                                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,0,0" />

                                    <Border Background="#33FF9800" CornerRadius="4" Padding="8"
                                            IsVisible="{Binding IsBitrateWarningVisible}" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="⚠" Foreground="#F59E0B" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Main.BitrateWarning}" Foreground="#D97706" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="100, *" IsVisible="{Binding IsAdvancedVideoControlsVisible}">
                                <TextBlock Text="{DynamicResource Main.Codec}" Classes="Label" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CodecOptions}" SelectedItem="{Binding SelectedCodecOption}" 
                                          HorizontalAlignment="Left" Width="300">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnDefinitions="100, *" IsVisible="{Binding IsAdvancedVideoControlsVisible}">
                                <Grid ColumnDefinitions="*, 6, 30" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding HardwareEncoderLabel}"
                                               Classes="Label"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Content="{Binding HardwareEncoderHelpLabel}"
                                            Grid.Column="2"
                                            Command="{Binding ShowHardwareAccelerationHelpCommand}"
                                            Width="30"
                                            Height="30"
                                            MinWidth="30"
                                            MinHeight="30"
                                            Padding="0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                                </Grid>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding HardwareEncoderOptions}" SelectedItem="{Binding SelectedHardwareEncoderOption}" 
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontStyle="Italic"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="180"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnDefinitions="100, *" IsVisible="{Binding IsAdvancedVideoControlsVisible}">
                                <TextBlock Text="{Binding CrfQualityLabel}" Classes="Label" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <CheckBox Content="{Binding EnableCrfLabel}"
                                              IsChecked="{Binding UseCrf}"
                                              Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <Grid ColumnDefinitions="*, 12, 80" IsVisible="{Binding IsCrfControlsVisible}">
                                        <Slider Grid.Column="0"
                                                Value="{Binding CrfSliderValue}"
                                                Minimum="0"
                                                Maximum="51"
                                                VerticalAlignment="Center"
                                                Height="34" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Crf}"
                                                 Width="80"
                                                 Height="34"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding CrfSelectionText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="100, *">
                                <TextBlock Text="{DynamicResource Main.EstimatedResult}" Classes="Label" />
                                <TextBlock Grid.Column="1" Text="{Binding EstimatedBitrateText}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding EstimatedBitrateColor, Converter={StaticResource StringToColorConverter}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="Card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="H1" Text="{DynamicResource Main.OutputSettings}" />
                            <Grid ColumnDefinitions="*, 10, Auto">
                                <TextBox Grid.Column="0" Text="{Binding OutputPathText}"
                                         Watermark="{DynamicResource Main.OutputWatermark}" IsReadOnly="True" Height="38"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Content="{DynamicResource Main.ChangeOutput}" Command="{Binding SelectOutputFolderCommand}"
                                        Height="38" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,10,0,0" RowDefinitions="Auto, Auto">

                <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource ConsoleBgColor}"
                        Padding="12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto, *">
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource Main.CliPreview}" Foreground="#6B7280" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Command="{Binding CopyCommandTextCommand}"
                                    Content="{DynamicResource Main.Copy}"
                                    Height="26"
                                    Padding="10,0"
                                    FontSize="12"
                                    Foreground="#D1D5DB"
                                    BorderBrush="#374151"
                                    Background="#1F2937"
                                    ToolTip.Tip="{DynamicResource Main.CopyCommand}"/>
                        </Grid>
                        <SelectableTextBlock Grid.Row="1" Text="{Binding CommandText}"
                                             FontFamily="Consolas, Cascadia Code, Monospace" FontSize="12"
                                             Foreground="#10B981" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*, 20, Auto" HorizontalAlignment="Stretch">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="5">
                        <ProgressBar Height="6" IsVisible="{Binding IsProgressVisible}" IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource BorderBrush}" CornerRadius="3" />
                        <TextBlock Text="{DynamicResource Main.Processing}" IsVisible="{Binding IsProcessing}"
                                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="2" Classes="Accent" Command="{Binding ExecuteCommand}"
                            IsEnabled="{Binding CanExecute}"
                            Height="44" Width="140" FontSize="16"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="▶" />
                            <TextBlock Text="{DynamicResource Main.StartConvert}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
