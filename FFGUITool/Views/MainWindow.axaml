    <!-- </Window.Resources> -->

    <Window.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.H1">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="Button.Accent:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style Selector="Button.ThemeToggle:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="Auto, *">
        <Menu Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}">
            <MenuItem Header="文件(_F)" Foreground="{DynamicResource PrimaryTextBrush}">
                <MenuItem Header="退出(_X)" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="工具(_T)" Foreground="{DynamicResource PrimaryTextBrush}">
                <MenuItem Header="FFmpeg设置(_S)" Command="{Binding ShowFFmpegSettingsCommand}" />
                <Separator />
                <MenuItem Header="重新检测FFmpeg(_R)" Command="{Binding RedetectFFmpegCommand}" />
            </MenuItem>
            <MenuItem Header="外观(_V)" Foreground="{DynamicResource PrimaryTextBrush}">


                <CheckBox Content="跟随系统颜色"
                          IsChecked="{Binding IsFollowSystemTheme}"
                          VerticalAlignment="Center" />


            </MenuItem>
            <MenuItem Header="帮助(_H)" Foreground="{DynamicResource PrimaryTextBrush}">
                <MenuItem Header="关于(_A)" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="24" RowDefinitions="Auto, *, Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FFGUITool" FontSize="28" FontWeight="ExtraBold"
                               Foreground="{DynamicResource AccentBrush}" LetterSpacing="1" />
                    <Border Background="{DynamicResource BorderBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding FfmpegStatusText}" FontSize="12"
                                   Foreground="{Binding FfmpegStatusColor}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding ToggleThemeCommand}"
                        IsEnabled="{Binding !IsFollowSystemTheme}"
                        Classes="Icon ThemeToggle" BorderThickness="0" Background="Transparent"
                        ToolTip.Tip="切换主题">
                    <Panel Width="24" Height="24">
                        <TextBlock Text="🌙" FontSize="18" IsVisible="{Binding !IsThemeDark}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="☀️" FontSize="18" IsVisible="{Binding IsThemeDark}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="0,0,16,0">
                <StackPanel>

                    <Border Classes="Card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="H1" Text="输入源" />
                            <Grid ColumnDefinitions="*, 10, Auto, 10, Auto">
                                <TextBox Grid.Column="0" Text="{Binding InputPathText}"
                                         Watermark="拖入文件或点击右侧按钮..." IsReadOnly="True" Height="38"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Content="选择文件" Command="{Binding SelectFileCommand}"
                                        Height="38" />
                                <Button Grid.Column="4" Content="选择文件夹" Command="{Binding SelectFolderCommand}"
                                        Height="38" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="Card" IsVisible="{Binding IsVideoInfoVisible}">
                        <StackPanel Spacing="10">
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Classes="H1" Text="源文件信息" DockPanel.Dock="Left" Margin="0"
                                           VerticalAlignment="Center" />

                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="8,4"
                                        DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentVideoInfo.Resolution}"
                                               Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </DockPanel>

                            <UniformGrid Columns="3" Rows="1" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="大小" Classes="Label" FontSize="12" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CurrentVideoInfo.FormattedFileSize}" FontSize="16"
                                               FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="时长" Classes="Label" FontSize="12" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CurrentVideoInfo.FormattedDuration}" FontSize="16"
                                               FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="原比特率" Classes="Label" FontSize="12" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CurrentVideoInfo.Bitrate, StringFormat='{}{0} kbps'}"
                                               FontSize="16" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Classes="Card">
                        <StackPanel Spacing="20">
                            <TextBlock Classes="H1" Text="压缩参数" />

                            <Grid ColumnDefinitions="100, *, Auto" Margin="0,0,0,16">
                                <TextBlock Grid.Column="0" Text="压缩强度" Classes="Label" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Slider Grid.Column="0"
                                                Value="{Binding CompressionPercentage}"
                                                Minimum="1"
                                                Maximum="100"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Text="{Binding CompressionPercentage, Mode=TwoWay}"
                                                     Width="60"
                                                     Height="34"
                                                     VerticalContentAlignment="Center"
                                                     HorizontalContentAlignment="Center" />
                                            <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="支持手动输入 1-100 之间的数值，步进精度为 1%"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <Separator Background="{DynamicResource BorderBrush}" Height="1" Opacity="0.5"
                                       Margin="0,0,0,16" />

                            <Grid ColumnDefinitions="100, *, Auto" Margin="0,0,0,16">
                                <TextBlock Grid.Column="0" Text="目标码率" Classes="Label" VerticalAlignment="Top"
                                           Margin="0,6,0,0" />

                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Slider Grid.Column="0" Value="{Binding BitrateSliderValue}"
                                                Minimum="{Binding BitrateSliderMinimum}"
                                                Maximum="{Binding BitrateSliderMaximum}"
                                                VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <TextBox Grid.Column="1" Text="{Binding Bitrate}" Width="80"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <TextBlock Text="{Binding BitrateValueText, StringFormat='当前选择: {0}'}"
                                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,4,0,0" />

                                    <Border Background="#33FF9800" CornerRadius="4" Padding="8"
                                            IsVisible="{Binding IsBitrateWarningVisible}" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="⚠" Foreground="#F59E0B" VerticalAlignment="Center" />
                                            <TextBlock Text="警告：当前比特率高于原视频，文件可能会变大" Foreground="#D97706" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="100, *">
                                <TextBlock Text="编码器" Classes="Label" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CodecOptions}"
                                          SelectedItem="{Binding SelectedCodecOption}"
                                          HorizontalAlignment="Left" Width="300">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontStyle="Italic" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnDefinitions="100, *">
                                <TextBlock Text="预估结果" Classes="Label" />
                                <TextBlock Grid.Column="1" Text="{Binding EstimatedBitrateText}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding EstimatedBitrateColor, Converter={StaticResource StringToColorConverter}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="Card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="H1" Text="输出设置" />
                            <Grid ColumnDefinitions="*, 10, Auto">
                                <TextBox Grid.Column="0" Text="{Binding OutputPathText}"
                                         Watermark="默认保存在源文件同目录下" IsReadOnly="True" Height="38"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="2" Content="更改保存位置" Command="{Binding SelectOutputFolderCommand}"
                                        Height="38" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,10,0,0" RowDefinitions="Auto, Auto">

                <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource ConsoleBgColor}"
                        Padding="12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Text="CLI COMMAND PREVIEW" Foreground="#6B7280" FontSize="10" FontWeight="Bold"
                                   Margin="0,0,0,4" />
                        <SelectableTextBlock Grid.Row="1" Text="{Binding CommandText}"
                                             FontFamily="Consolas, Cascadia Code, Monospace" FontSize="12"
                                             Foreground="#10B981" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*, 20, Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="5">
                        <ProgressBar Height="6" IsVisible="{Binding IsProgressVisible}" IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource BorderBrush}" CornerRadius="3" />
                        <TextBlock Text="正在处理中..." IsVisible="{Binding IsProcessing}"
                                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="2" Classes="Accent" Command="{Binding ExecuteCommand}"
                            IsEnabled="{Binding CanExecute}"
                            Height="44" Width="140" FontSize="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="▶" />
                            <TextBlock Text="开始转换" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>