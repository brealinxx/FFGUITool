<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFGUITool.ViewModels"
        x:Class="FFGUITool.Views.SetupWindow"
        x:DataType="vm:SetupWindowViewModel"
        Title="{DynamicResource Setup.Title}"
        Width="620" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="/Resources/icon.ico"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Border.SetupCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="4,0,4,16"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style Selector="TextBlock.Caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="24,30,24,24">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Setup.Header}" FontSize="26" FontWeight="ExtraBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="{DynamicResource Setup.Subtitle}" Classes="Caption" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Width="130">
                <TextBlock Text="{DynamicResource Setup.Language}" Classes="Caption"/>
                <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" Height="34">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSetupTabIndex}">
            <TabItem Header="{DynamicResource Setup.FFmpegTab}">
                <ScrollViewer Padding="0,12,10,0">
                    <StackPanel>
                        <Border Classes="SetupCard">
                            <StackPanel Spacing="12">
                                <Button Content="{DynamicResource Setup.DetectSystemFFmpeg}"
                                        Command="{Binding DetectSystemFFmpegCommand}"
                                        IsEnabled="{Binding !IsProcessing}"/>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="8" Padding="8">
                                        <TextBlock Text="FF" FontSize="14" FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Setup.Manual}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{DynamicResource Setup.ManualDesc}" Classes="Caption"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, 10, Auto">
                                    <TextBox Grid.Column="0" Text="{Binding FfmpegPathText}"
                                             Watermark="{DynamicResource Setup.SelectFileWatermark}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Setup.Browse}" Command="{Binding BrowseFFmpegCommand}"/>
                                </Grid>

                                <Button Content="{DynamicResource Setup.ApplyPath}" Classes="Accent" HorizontalAlignment="Stretch"
                                        Command="{Binding SetCustomPathCommand}" IsEnabled="{Binding !IsProcessing}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="SetupCard">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="8" Padding="8">
                                        <TextBlock Text="ZIP" FontSize="13" FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Setup.Archive}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{DynamicResource Setup.ArchiveDesc}" Classes="Caption"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, 10, Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ArchivePathText}"
                                             Watermark="{DynamicResource Setup.ArchiveWatermark}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Setup.Browse}" Command="{Binding BrowseArchiveCommand}"/>
                                </Grid>

                                <Button Content="{DynamicResource Setup.InstallNow}" Classes="Accent" HorizontalAlignment="Stretch"
                                        Command="{Binding InstallFromArchiveCommand}" IsEnabled="{Binding !IsProcessing}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="SetupCard" BorderThickness="0" Margin="4,8,4,8">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.1"/>
                            </Border.Background>
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource Setup.HowToGet}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Setup.DownloadHint}" Classes="Caption"/>
                                <Grid ColumnDefinitions="Auto, 8, *, 8, Auto">
                                    <TextBlock Text="{DynamicResource Setup.Link}" Classes="Caption" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="https://ffmpeg.org/download.html" IsReadOnly="True"/>
                                    <Button Grid.Column="4" Content="{DynamicResource Setup.OpenLink}"
                                            Command="{Binding OpenUrlCommand}"
                                            CommandParameter="https://ffmpeg.org/download.html"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource Setup.Recommend}" Classes="Caption"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Setup.ExifToolTab}">
                <ScrollViewer Padding="0,12,10,0">
                    <StackPanel>
                        <Border Classes="SetupCard">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="8" Padding="8">
                                        <TextBlock Text="EX" FontSize="14" FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource ExifTool.SetupTitle}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{DynamicResource ExifTool.SetupDesc}" Classes="Caption"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Content="{DynamicResource ExifTool.DetectSystem}"
                                        Command="{Binding DetectSystemExifToolCommand}"
                                        IsEnabled="{Binding !IsProcessing}"/>

                                <Grid ColumnDefinitions="*, 10, Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ExifToolPathText}"
                                             Watermark="{DynamicResource ExifTool.SelectExecutableWatermark}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Setup.Browse}" Command="{Binding BrowseExifToolCommand}"/>
                                </Grid>
                                <Button Content="{DynamicResource ExifTool.ApplyExecutable}" Classes="Accent" HorizontalAlignment="Stretch"
                                        Command="{Binding SetExifToolPathCommand}" IsEnabled="{Binding !IsProcessing}"/>

                                <Grid ColumnDefinitions="*, 10, Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ExifToolFolderText}"
                                             Watermark="{DynamicResource ExifTool.SelectFolderWatermark}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Setup.Browse}" Command="{Binding BrowseExifToolFolderCommand}"/>
                                </Grid>
                                <Button Content="{DynamicResource ExifTool.ApplyFolder}" Classes="Accent" HorizontalAlignment="Stretch"
                                        Command="{Binding SetExifToolFolderCommand}" IsEnabled="{Binding !IsProcessing}"/>

                                <Grid ColumnDefinitions="*, 10, Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ExifToolArchivePathText}"
                                             Watermark="{DynamicResource ExifTool.ArchiveWatermark}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Setup.Browse}" Command="{Binding BrowseExifToolArchiveCommand}"/>
                                </Grid>
                                <Button Content="{DynamicResource ExifTool.InstallArchive}" Classes="Accent" HorizontalAlignment="Stretch"
                                        Command="{Binding InstallExifToolArchiveCommand}" IsEnabled="{Binding !IsProcessing}"/>

                            </StackPanel>
                        </Border>

                        <Border Classes="SetupCard" BorderThickness="0" Margin="4,8,4,8">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.1"/>
                            </Border.Background>
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource Setup.HowToGetExifTool}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Setup.ExifToolDownloadHint}" Classes="Caption"/>
                                <Grid ColumnDefinitions="Auto, 8, *, 8, Auto">
                                    <TextBlock Text="{DynamicResource Setup.Link}" Classes="Caption" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="https://exiftool.org/" IsReadOnly="True"/>
                                    <Button Grid.Column="4" Content="{DynamicResource Setup.OpenLink}"
                                            Command="{Binding OpenUrlCommand}"
                                            CommandParameter="https://exiftool.org/"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Border IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource PageBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="12,8" CornerRadius="6" Margin="0,0,0,16">
                <Grid ColumnDefinitions="Auto, *">
                    <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="20" Height="20" 
                                 IsVisible="{Binding IsProcessing}" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*, Auto, Auto">
                <TextBlock Grid.Column="0" Text="{DynamicResource Setup.Footer}" VerticalAlignment="Center" Classes="Caption"/>

                <Button Grid.Column="1" Content="{DynamicResource Setup.Skip}" Command="{Binding SkipCommand}"
                        Background="Transparent" BorderThickness="0" Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                        Content="{DynamicResource Setup.Confirm}"
                        Command="{Binding ConfirmCommand}"
                        Classes="Accent"
                        Width="120"
                        CornerRadius="20"
                        IsEnabled="{Binding !IsProcessing}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
