<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFGUITool.ViewModels"
        x:Class="FFGUITool.Views.SetupWindow"
        x:DataType="vm:SetupWindowViewModel"
        Title="FFmpeg 引导设置"
        Width="540" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Border.SetupCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="4,0,4,16"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style Selector="TextBlock.Caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="24,30,24,24">

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock Text="初始化 FFmpeg" FontSize="26" FontWeight="ExtraBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="为了正常处理视频，请选择一种方式配置核心组件"
                       Classes="Caption" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="0,0,10,0">
            <StackPanel>
                <Border Classes="SetupCard">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="8" Padding="8">
                                <TextBlock Text="📂" FontSize="18"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="手动指定路径" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="直接指向现有的 ffmpeg.exe" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, 10, Auto">
                            <TextBox Grid.Column="0" Text="{Binding FfmpegPathText}"
                                     Watermark="请选择文件..." IsReadOnly="True"/>
                            <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseFFmpegCommand}"/>
                        </Grid>

                        <Button Content="应用此路径" Classes="Accent" HorizontalAlignment="Stretch"
                                Command="{Binding SetCustomPathCommand}" IsEnabled="{Binding !IsProcessing}"/>
                    </StackPanel>
                </Border>

                <Border Classes="SetupCard">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="8" Padding="8">
                                <TextBlock Text="📦" FontSize="18"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="从压缩包安装" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="自动解压并配置环境" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, 10, Auto">
                            <TextBox Grid.Column="0" Text="{Binding ArchivePathText}"
                                     Watermark="请选择 .zip 压缩包..." IsReadOnly="True"/>
                            <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseArchiveCommand}"/>
                        </Grid>

                        <Button Content="立即解压并安装" Classes="Accent" HorizontalAlignment="Stretch"
                                Command="{Binding InstallFromArchiveCommand}" IsEnabled="{Binding !IsProcessing}"/>
                    </StackPanel>
                </Border>

                <Border Classes="SetupCard" BorderThickness="0" Margin="4,8,4,8">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.1"/>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💡" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="如何获取 FFmpeg？" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock FontSize="13" LineHeight="22" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap">
                            <Run Text="访问 "/>
                            <Run Text="ffmpeg.org" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <Run Text=" 下载 Windows builds 静态版本 (Static)。" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <LineBreak/>
                            <Run Text="推荐直接下载压缩包并使用上方“从压缩包安装”功能。" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Border IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource PageBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="12,8" CornerRadius="6" Margin="0,0,0,16">
                <Grid ColumnDefinitions="Auto, *">
                    <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="20" Height="20" 
                                 IsVisible="{Binding IsProcessing}" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*, Auto, Auto">
                <TextBlock Grid.Column="0" Text="稍后可在菜单中修改" VerticalAlignment="Center" Classes="Caption"/>

                <Button Grid.Column="1" Content="跳过" Command="{Binding SkipCommand}"
                        Background="Transparent" BorderThickness="0" Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                        Content="完成配置"
                        Command="{Binding ConfirmCommand}"
                        Classes="Accent"
                        Width="120"
                        CornerRadius="20"
                        IsEnabled="{Binding !IsProcessing}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>